# ==============================================================================
# Little Sun - Comprehensive Airtight .gitignore
# Strictly excludes build outputs, virtual environments, caches, OS files & media
# ==============================================================================

# --- Node & Dependencies ---
node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
jspm_packages/
.pnp
.pnp.js

# --- Build Outputs & Compilers ---
dist/
build/
out/
bin/
obj/
dev-dist/
Release/
Debug/
*.tsbuildinfo

# --- Python Virtual Environments & Bytecode ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Caches & Local Performance Store ---
.cache/
.npm/
.eslintcache
.stylelintcache
.turbo/
.parcel-cache/
coverage/
*.lcov

# --- Logs & Runtime State ---
logs/
*.log
little-sun-gateway/logs/
.gateway-target.json

# --- Temporary & Staging Directories ---
tmp/
temp/
*.tmp
little-sun-gateway/tmp/

# --- Environment & Secret Variables (Strictly excluded) ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
little-sun-gateway/.env
little-sun-gateway/.env.local
little-sun-gateway/.env.*.local
# Preserved committed examples:
!.env.example
!little-sun-gateway/.env.example

# --- Heavy Media, Weights & Binary Archives ---
little-sun-gateway/bin/
*.gguf
*.bin
*.safetensors
*.onnx
*.pt
*.pth
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.iso
!little-sun-gateway/models/.gitkeep

# --- OS System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDE & Editor Settings ---
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
